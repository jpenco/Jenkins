pipeline {
    agent any 
    stages {
        stage('Coletar Métricas do Servidor') {
            steps {
                script {
                    // 1. Captura o Uptime
                    env.SERVER_UPTIME = sh(script: "uptime -p | sed 's/up //'", returnStdout: true).trim()
                    
                    // 2. Captura a Quantidade de Processadores
                    env.SERVER_CPUS = sh(script: "nproc", returnStdout: true).trim()
                    
                    // 3. Captura os dados da Memória RAM (Cálculo e formatação via awk)
                    env.SERVER_RAM = sh(
                        script: "free -m | awk '/Mem:/ {printf \"Total: %.1f GB, Usada: %.1f GB (%.1f%%)\", \$2/1024, \$3/1024, \$3/\$2*100}'",
                        returnStdout: true
                    ).trim()
                    
                    // 4. Captura os dados do Espaço em Disco (Cálculo focado na Raiz /)
                    env.SERVER_DISK = sh(
                        script: "df -k / | awk 'NR==2 {printf \"Total: %.1f GB, Usado: %.1f GB (%.1f%%)\", \$2/1024/1024, \$3/1024/1024, \$3/\$2*100}'",
                        returnStdout: true
                    ).trim()
                }
            }
        }
    }
    post {
        always {
            // Bloco de saída única consolidando todas as informações coletadas
            echo """
========================================
       📊 RELATÓRIO DO SERVIDOR
========================================
🕒 Uptime: ${env.SERVER_UPTIME}
⚙️ Processadores: ${env.SERVER_CPUS} núcleos
🧠 Memória RAM: ${env.SERVER_RAM}
💾 Espaço em Disco (Raiz /): ${env.SERVER_DISK}
========================================
✅ Monitoramento concluído com sucesso.
"""
        }
    }
}
