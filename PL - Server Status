pipeline {
    agent any 
    stages {
        stage('Monitoramento do Servidor') {
            steps {
                script {
                    echo "=== INFORMAÇÕES DO SERVIDOR ==="
                    
                    // Uptime em dias e horas
                    def uptime = sh(script: "uptime -p | sed 's/up //'", returnStdout: true).trim()
                    echo "🕒 Uptime: ${uptime}"
                    
                    // Quantidade de processadores
                    def processors = sh(script: "nproc", returnStdout: true).trim()
                    echo "⚙️ Processadores: ${processors} núcleos"
                    
                    // Memória RAM (uso e total) - Corrigido escape e cálculo em Megabytes
                    sh '''
                        echo "🧠 Memória RAM:"
                        free -m | awk '/Mem:/ {printf "Total: %.1f GB, Usada: %.1f GB (%.1f%%)\\n", \$2/1024, \$3/1024, \$3/\$2*100}'
                    '''
                    
                    // Espaço em disco (uso e total) - Corrigido escape e cálculo em Kilobytes
                    sh '''
                        echo "💾 Espaço em Disco (Raiz /):"
                        df -k / | awk 'NR==2 {printf "Total: %.1f GB, Usado: %.1f GB (%.1f%%)\\n", \$2/1024/1024, \$3/1024/1024, \$3/\$2*100}'
                    '''
                    
                    echo "============================"
                }
            }
        }
    }
    post {
        always {
            echo "✅ Monitoramento concluído com sucesso"
        }
    }
}
